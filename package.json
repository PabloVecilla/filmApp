{
  "name": "film-App",
  "version": "1.0.0",
  "description": "film app",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test:db:up": "docker compose -f docker-compose.test.yml up -d --wait postgres-test mongo-test",
    "test:db:down": "docker compose -f docker-compose.test.yml down -v --remove-orphans",
    "test": "npm run test:docker",
    "test:jest": "cross-env NODE_ENV=test jest --runInBand --verbose",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:ci": "cross-env NODE_ENV=test jest --runInBand --coverage",
    "test:integration": "npm run db:migrate:test && npm run test",
    "test:docker": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit --exit-code-from test-runner",
    "test:docker:clean": "docker compose -f docker-compose.test.yml down -v --remove-orphans",
    "test:docker:fresh": "npm run test:docker:clean && npm run test:docker",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:production": "cross-env NODE_ENV=production sequelize-cli db:migrate --env production",
    "db:migrate:test": "cross-env NODE_ENV=test sequelize-cli db:migrate --env test",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:test:undo": "cross-env NODE_ENV=test sequelize-cli db:migrate:undo --env test",
    "db:migrate:test:reset": "cross-env NODE_ENV=test sequelize-cli db:migrate:undo:all --env test && npm run db:migrate:test",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "docs": "node docs/generate-openapi.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PabloVecilla/filmApp.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/PabloVecilla/filmApp/issues"
  },
  "homepage": "https://github.com/PabloVecilla/filmApp#readme",
  "dependencies": {
    "axios": "^1.15.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "ejs": "^5.0.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "8.24.5",
    "morgan": "^1.10.1",
    "pg": "^8.20.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "overrides": {
    "marked": "4.0.10"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "postman-to-openapi": "^1.7.3",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.3.1"
  }
}
